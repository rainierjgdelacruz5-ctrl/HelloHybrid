{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Hello Kaffi",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["start"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "3000",
        "uriFormat": "http://localhost:3000/",
        "action": "openExternally"
      }
    }
  ]
}